{
	# Let's Encrypt sends certificate expiry warnings here. Set in /opt/terhal/edge/.env, kept out of git.
	email {$ACME_EMAIL}
}

# Shared by every site: compress responses and stop browsers ever falling back to plain http.
(common) {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}

# The API. Caddy overwrites X-Real-IP with the address that actually connected, whatever the client sent, and the rate
# limiter trusts only that header (apps/server/src/platform/rate-limit/rate-limit.ts).
(api) {
	import common
	reverse_proxy {args[0]}:8080 {
		header_up X-Real-IP {remote_host}
	}
}

(web) {
	import common
	reverse_proxy {args[0]}:3000
}

# One file per environment, written by that environment's deploy (deploy/caddy/<env>.caddy).
import sites/*.caddy
