# Copy to /opt/terhal/<env>/app.env on the VPS (chmod 600) and fill in. Each environment has its own values; this file is
# never in git and deploys never touch it. Restart the stack after changing it: docker compose up -d --force-recreate
#
# Values below are for staging; for main drop ".staging" from the hosts and use the main Neon branch.

# The Neon branch's pooled URL (runtime) and direct URL (migrations only).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# This environment's three frontends. Each is the only browser origin allowed to call its own routes.
SITE_URL=https://staging.terhal.co
DASHBOARD_URL=https://dashboard.staging.terhal.co
ADMIN_URL=https://admin.staging.terhal.co

RESEND_KEY=
RESEND_EMAIL=Terhal Staging <no-reply@terhal.co>

# openssl rand -base64 32. Changing it signs every admin out.
ADMIN_SECRET=
# openssl rand -base64 32. Changing it breaks every admin's authenticator setup.
TOTP_ENCRYPTION_KEY=
