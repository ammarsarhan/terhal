// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  STAFF
}

enum UserStatus {
  UNVERIFIED
  ACTIVE
  SUSPENDED
  DELETED
}

enum TripSource {
  USER
  STAFF
}

enum TripStatus {
  PENDING
  CANCELLED
  CONFIRMED
  IN_PROGRESS
  AWAITING_REPORT
  COMPLETED
}

enum TripClass {
  ECONOMY
  VIP
}

enum CarBody {
  SEDAN
  SUV
  MINIVAN
  VAN
}

enum ExpenseType {
  INTERCITY_TOLL
  FUEL
  CAR_MAINTENANCE
  DRIVER_FEE
  OTHER
}

enum DocumentType {
  REPORT
  IMAGE
}

model Trip {
  id     String     @id @default(cuid())
  code   String     @unique
  source TripSource
  status TripStatus @default(PENDING)

  // One of these relationships must always be available. Added the Staff model relationship in case they need to add a Trip.
  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?

  guestSession   GuestSession? @relation(fields: [guestSessionId], references: [id])
  guestSessionId String?

  staff   Staff?  @relation(fields: [staffId], references: [id])
  staffId String?

  // Created as optional initially until they are assigned by staff.
  driver    Driver?  @relation(fields: [driverId], references: [id])
  driverId  String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  vehicleId String?

  // Report optional until created and linked by the driver.
  report TripReport?

  // Keep a log of all of the events that occur per the trip.
  events TripEvent[]

  clientName  String
  clientPhone String
  class       TripClass
  smallLuggage  Int
  mediumLuggage Int
  largeLuggage  Int
  passengers Int
  car        CarBody
  totalPrice Decimal

  notes String?

  pickupId        String
  pickupSnapshot  String
  pickupLatitude  Decimal
  pickupLongitude Decimal

  dropoffId        String
  dropoffSnapshot  String
  dropoffLatitude  Decimal
  dropoffLongitude Decimal

  // Link a trip to another trip such that we can keep track of round-about trips.
  previousTrip   Trip?   @relation("TripChain", fields: [previousTripId], references: [id])
  previousTripId String? @unique

  subsequentTrip Trip? @relation("TripChain")
}

model TripEvent {
  id String @id @default(cuid())

  staff   Staff  @relation(fields: [staffId], references: [id])
  staffId String

  trip   Trip   @relation(fields: [tripId], references: [id])
  tripId String

  action String

  createdAt DateTime @default(now())
}

model TripReport {
  id     String @id @default(cuid())
  tripId String @unique
  trip   Trip   @relation(references: [id], fields: [tripId])

  startedAt     DateTime
  vehiclePickup String
  startMileage  Int

  pickupAt  DateTime
  dropoffAt DateTime

  vehicleDropoff String
  endedAt        DateTime
  endMileage     Int

  stops    TripStop[]
  expenses TripExpense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TripStop {
  id String @id @default(cuid())

  report   TripReport @relation(fields: [reportId], references: [id])
  reportId String

  locationId String?
  address    String
  latitude   Decimal
  longitude  Decimal

  startedAt DateTime
  endedAt   DateTime

  notes String?
}

model TripExpense {
  id String @id @default(cuid())

  report   TripReport @relation(fields: [reportId], references: [id])
  reportId String

  amount Decimal
  type   ExpenseType
  notes  String?
}

model GuestSession {
  id String @id @default(cuid())

  firstName String
  lastName  String
  phone     String
  email     String

  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  trips Trip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSession {
  id           String @id @default(cuid())
  refreshToken String @unique
  userId       String
  user         User   @relation(fields: [userId], references: [id])

  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  ipAddress String?
  userAgent String?
}

model User {
  id String @id @default(cuid())

  firstName String
  lastName  String
  role      UserRole   @default(CUSTOMER)
  status    UserStatus @default(UNVERIFIED)

  sessions UserSession[]
  phone    String        @unique
  email    String        @unique

  passwordHash String

  staff    Staff?
  customer Customer?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invitation {
  id String @id @default(cuid())

  email     String
  tokenHash String @unique

  invitor   Staff  @relation(fields: [invitorId], references: [id])
  invitorId String @unique

  permissions Json?

  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
}

model Staff {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  permissions Json

  trips       Trip[]
  events      TripEvent[]
  invitations Invitation[]
}

model Customer {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  trips Trip[]
}

model Driver {
  id String @id @default(cuid())

  firstName String
  lastName  String
  phone     String @unique

  amountOwed Decimal
  isExternal Boolean @default(false)
  company    String?

  trips Trip[]

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vehicle {
  id String @id @default(cuid())

  make   String
  model  String
  year   Int?
  images VehicleImage[]

  plateNumber String @unique
  color       String

  isExternal Boolean @default(false)
  office     String?

  trips Trip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VehicleImage {
  id String @id @default(cuid())

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  vehicleId String

  bucket String
  key    String @unique

  createdAt DateTime @default(now())
}

model AnalyticsDocument {
  id String @id @default(cuid())

  bucket String
  key    String @unique
  month  Int
  year   Int

  createdAt DateTime @default(now())
}
