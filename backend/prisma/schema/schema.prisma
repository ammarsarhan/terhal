// Models live in per-domain files alongside this one (staff, customer, admin, location, pricing, fleet, trip,
// notification, analytics).
//
// Optional relations use onDelete: Restrict, so deleting a row that others still point at fails instead of silently
// nulling their reference.

generator client {
  provider = "prisma-client"
  output   = "../../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
