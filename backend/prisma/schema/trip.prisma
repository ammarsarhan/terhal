enum TripSource {
  USER
  STAFF
}

enum TripStatus {
  PENDING
  CANCELLED
  CONFIRMED
  IN_PROGRESS
  AWAITING_REPORT
  COMPLETED
}

enum TripClass {
  ECONOMY
  VIP
}

enum CarBody {
  SEDAN
  SUV
  MINIVAN
  VAN
}

enum ExpenseType {
  INTERCITY_TOLL
  FUEL
  CAR_MAINTENANCE
  DRIVER_FEE
  OTHER
}

model Trip {
  id     String     @id @default(cuid())
  code   String     @unique
  source TripSource
  status TripStatus @default(PENDING)

  // One of these relationships must always be available. Added the Staff model relationship in case they need to add a Trip.
  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?

  guestSession   GuestSession? @relation(fields: [guestSessionId], references: [id])
  guestSessionId String?

  staff   Staff?  @relation(fields: [staffId], references: [id])
  staffId String?

  // Created as optional initially until they are assigned by staff.
  driver    Driver?  @relation(fields: [driverId], references: [id])
  driverId  String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  vehicleId String?

  // Report optional until created and linked by the driver.
  report TripReport?

  // Keep a log of all of the events that occur per the trip.
  events TripEvent[]

  clientName    String
  clientPhone   String
  pickupDate    DateTime
  class         TripClass
  smallLuggage  Int
  mediumLuggage Int
  largeLuggage  Int
  passengers    Int
  car           CarBody
  totalPrice    Decimal

  notes String?

  pickupId        String
  pickupSnapshot  String
  pickupLatitude  Decimal
  pickupLongitude Decimal

  dropoffId        String
  dropoffSnapshot  String
  dropoffLatitude  Decimal
  dropoffLongitude Decimal

  // Link a trip to another trip such that we can keep track of round-about trips.
  previousTrip   Trip?   @relation("TripChain", fields: [previousTripId], references: [id])
  previousTripId String? @unique

  subsequentTrip Trip? @relation("TripChain")
}

model TripEvent {
  id String @id @default(cuid())

  staff   Staff  @relation(fields: [staffId], references: [id])
  staffId String

  trip   Trip   @relation(fields: [tripId], references: [id])
  tripId String

  action String

  createdAt DateTime @default(now())
}

model TripReport {
  id     String @id @default(cuid())
  tripId String @unique
  trip   Trip   @relation(references: [id], fields: [tripId])

  startedAt     DateTime
  vehiclePickup String
  startMileage  Int

  pickupAt  DateTime
  dropoffAt DateTime

  vehicleDropoff String
  endedAt        DateTime
  endMileage     Int

  stops    TripStop[]
  expenses TripExpense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TripStop {
  id String @id @default(cuid())

  report   TripReport @relation(fields: [reportId], references: [id])
  reportId String

  locationId String?
  address    String
  latitude   Decimal
  longitude  Decimal

  startedAt DateTime
  endedAt   DateTime

  notes String?
}

model TripExpense {
  id String @id @default(cuid())

  report   TripReport @relation(fields: [reportId], references: [id])
  reportId String

  amount Decimal
  type   ExpenseType
  notes  String?
}
