# Local values match docker-compose.yml. Locally both URLs point at the same Postgres; on Render, DATABASE_URL is the
# Neon branch's pooled URL (runtime) and DATABASE_URL_UNPOOLED its direct URL (migrations).
# These win over the repo-root .env.local, which `neon env pull` writes only when you need to reach a Neon branch.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/terhal
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/terhal

# Local values match docker-compose.yml. On Render, each Key Value instance's internal connection string.
CACHE_URL=redis://localhost:6379
QUEUE_URL=redis://localhost:6380

# Render injects PORT for the server service.
PORT=8080
# The three frontends of this environment. Each is the only browser origin allowed to call its own routes, and the base of
# the links emailed to its users. Optional locally (these are the defaults), required in production.
SITE_URL=https://local.terhal.co:3000
DASHBOARD_URL=https://dashboard.local.terhal.co:3000
ADMIN_URL=https://admin.local.terhal.co:3000

# Local https (see the README). Render terminates TLS itself, so these are never set there.
TLS_CERT=../.certs/local.pem
TLS_KEY=../.certs/local-key.pem

# Email (Resend). Leave RESEND_KEY empty in development to log emails to the console instead.
RESEND_KEY=
RESEND_EMAIL=

# Seeding (db:seed). Emails an invitation link to the first admin. Only works while no admin exists.
ADMIN_EMAIL=

# Encrypts admins' two-factor secrets in the database. Changing it breaks every admin's existing authenticator setup.
TOTP_ENCRYPTION_KEY=

# Signs admin access tokens. Changing it signs every admin out.
ADMIN_SECRET=
