{
  "openapi": "3.1.0",
  "info": {
    "title": "Terhal API",
    "version": "1"
  },
  "components": {
    "securitySchemes": {
      "adminCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "admin_access",
        "description": "Set by signing in (httpOnly)."
      }
    },
    "schemas": {
      "AdminInvitationPreview": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "email",
          "expiresAt"
        ],
        "description": "What the invitee sees before accepting."
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "enum": [
              "BAD_REQUEST",
              "VALIDATION_FAILED",
              "NOT_FOUND",
              "FORBIDDEN",
              "PAYLOAD_TOO_LARGE",
              "INTERNAL_ERROR",
              "SERVICE_UNAVAILABLE",
              "RATE_LIMITED",
              "UNTRUSTED_ORIGIN",
              "UNAUTHENTICATED",
              "ACCESS_TOKEN_EXPIRED",
              "INVALID_CREDENTIALS",
              "ACCOUNT_NOT_ACTIVE",
              "INVALID_REFRESH_TOKEN",
              "ACCOUNT_ALREADY_EXISTS",
              "INVITATION_INVALID",
              "INVITATION_EXPIRED",
              "TOTP_SETUP_REQUIRED",
              "TOTP_CODE_INVALID",
              "TOTP_CHALLENGE_INVALID"
            ],
            "example": "VALIDATION_FAILED"
          },
          "detail": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "description": "Quote it to support."
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "detail"
        ],
        "additionalProperties": {},
        "description": "An error. Extra members depend on the code."
      },
      "TotpSetup": {
        "type": "object",
        "properties": {
          "uri": {
            "type": "string",
            "description": "The otpauth:// link to show as a QR code."
          },
          "secret": {
            "type": "string",
            "description": "The same secret, for typing in by hand."
          }
        },
        "required": [
          "uri",
          "secret"
        ]
      },
      "AdminInvitationToken": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "description": "From the invitation link."
          }
        },
        "required": [
          "token"
        ]
      },
      "Admin": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          }
        },
        "required": [
          "id",
          "firstName",
          "lastName",
          "email",
          "status"
        ]
      },
      "AcceptAdminInvitation": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "description": "From the invitation link."
          },
          "firstName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50
          },
          "lastName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72,
            "pattern": "[a-z]"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "example": "482913"
          }
        },
        "required": [
          "token",
          "firstName",
          "lastName",
          "password",
          "code"
        ]
      },
      "AdminChallenge": {
        "type": "object",
        "properties": {
          "twoFactorRequired": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "twoFactorRequired"
        ],
        "description": "Password right; send a code to /auth/verify."
      },
      "AdminSignIn": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 75,
            "example": "admin@terhal.co"
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AdminVerify": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "example": "482913"
          }
        },
        "required": [
          "code"
        ]
      },
      "AuditLog": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "admin.invitation.sent",
              "admin.invitation.revoked",
              "admin.invitation.totp_issued",
              "admin.invitation.accept_failed",
              "admin.invitation.accepted",
              "admin.totp.enabled",
              "admin.sign_in.password_failed",
              "admin.sign_in.password_passed",
              "admin.sign_in.totp_failed",
              "admin.sign_in.blocked",
              "admin.sign_in.succeeded",
              "admin.session.revoked",
              "admin.sign_out"
            ]
          },
          "entityType": {
            "type": "string"
          },
          "entityId": {
            "type": "string"
          },
          "ipAddress": {
            "type": [
              "string",
              "null"
            ]
          },
          "before": {},
          "after": {},
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "admin": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "firstName": {
                "type": "string"
              },
              "lastName": {
                "type": "string"
              },
              "email": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "firstName",
              "lastName",
              "email"
            ],
            "description": "Null for the system and for sign in attempts on unknown emails."
          }
        },
        "required": [
          "id",
          "action",
          "entityType",
          "entityId",
          "ipAddress",
          "createdAt",
          "admin"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/admin/invitations/lookup": {
      "get": {
        "tags": [
          "Admin auth"
        ],
        "summary": "Look up an invitation",
        "description": "What the invitee sees before accepting. Doesn't use the invitation up.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "From the invitation link."
            },
            "required": true,
            "description": "From the invitation link.",
            "name": "token",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "The invitation can be accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminInvitationPreview"
                }
              }
            }
          },
          "400": {
            "description": "INVITATION_INVALID or INVITATION_EXPIRED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED: see the Retry-After header.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/invitations/totp": {
      "post": {
        "tags": [
          "Admin auth"
        ],
        "summary": "Get the invitee's authenticator secret",
        "description": "Asking again returns the same secret, so an app that's already set up keeps working.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminInvitationToken"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Show the URI as a QR code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TotpSetup"
                }
              }
            }
          },
          "400": {
            "description": "INVITATION_INVALID or INVITATION_EXPIRED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED: see the Retry-After header.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/invitations/accept": {
      "post": {
        "tags": [
          "Admin auth"
        ],
        "summary": "Create an admin account from an invitation",
        "description": "Needs a current code from the authenticator set up with /v1/admin/invitations/totp.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptAdminInvitation"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created and signed in",
            "headers": {
              "Set-Cookie": {
                "description": "The access and refresh cookies (httpOnly; the web app never reads them).",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Admin"
                }
              }
            }
          },
          "400": {
            "description": "INVITATION_INVALID, INVITATION_EXPIRED, TOTP_SETUP_REQUIRED, TOTP_CODE_INVALID or VALIDATION_FAILED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "ACCOUNT_ALREADY_EXISTS",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED: see the Retry-After header.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/auth/sign-in": {
      "post": {
        "tags": [
          "Admin auth"
        ],
        "summary": "Check email and password",
        "description": "Sets a 5-minute challenge cookie. Always followed by /v1/admin/auth/verify.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminSignIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password right; ask for a code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminChallenge"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_FAILED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "INVALID_CREDENTIALS: the same for an unknown email and a wrong password.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "ACCOUNT_NOT_ACTIVE or TOTP_SETUP_REQUIRED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED: see the Retry-After header.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/auth/verify": {
      "post": {
        "tags": [
          "Admin auth"
        ],
        "summary": "Finish signing in with an authenticator code",
        "description": "Sets the session cookies. The session lasts 12 hours at most, however often it's refreshed.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminVerify"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "headers": {
              "Set-Cookie": {
                "description": "The access and refresh cookies (httpOnly; the web app never reads them).",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Admin"
                }
              }
            }
          },
          "400": {
            "description": "TOTP_CODE_INVALID or VALIDATION_FAILED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "TOTP_CHALLENGE_INVALID: sign in again.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "ACCOUNT_NOT_ACTIVE",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED: see the Retry-After header.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/auth/refresh": {
      "post": {
        "tags": [
          "Admin auth"
        ],
        "summary": "Renew the session cookies",
        "description": "Uses the refresh cookie and rotates it. Send one refresh at a time.",
        "security": [
          {
            "adminCookie": []
          }
        ],
        "responses": {
          "204": {
            "description": "New cookies set",
            "headers": {
              "Set-Cookie": {
                "description": "The access and refresh cookies (httpOnly; the web app never reads them).",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "INVALID_REFRESH_TOKEN: sign in again.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "ACCOUNT_NOT_ACTIVE",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED: see the Retry-After header.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/auth/sign-out": {
      "post": {
        "tags": [
          "Admin auth"
        ],
        "summary": "Sign out",
        "description": "Ends the session the refresh cookie belongs to and clears the cookies. Always succeeds.",
        "security": [
          {
            "adminCookie": []
          }
        ],
        "responses": {
          "204": {
            "description": "Signed out"
          }
        }
      }
    },
    "/v1/admin/auth/session": {
      "get": {
        "tags": [
          "Admin auth"
        ],
        "summary": "The signed in admin",
        "security": [
          {
            "adminCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "The admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Admin"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED or ACCESS_TOKEN_EXPIRED: refresh, or sign in.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "ACCOUNT_NOT_ACTIVE",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/admin/logs": {
      "get": {
        "tags": [
          "Audit log"
        ],
        "summary": "Search the audit log",
        "description": "Newest first by default. Pass `nextCursor` back as `cursor` for the next page.",
        "security": [
          {
            "adminCookie": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "createdAt",
                "action",
                "entityType"
              ],
              "default": "createdAt"
            },
            "required": false,
            "name": "sort",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "desc"
            },
            "required": false,
            "name": "order",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          },
          {
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "admin.invitation.sent",
                    "admin.invitation.revoked",
                    "admin.invitation.totp_issued",
                    "admin.invitation.accept_failed",
                    "admin.invitation.accepted",
                    "admin.totp.enabled",
                    "admin.sign_in.password_failed",
                    "admin.sign_in.password_passed",
                    "admin.sign_in.totp_failed",
                    "admin.sign_in.blocked",
                    "admin.sign_in.succeeded",
                    "admin.session.revoked",
                    "admin.sign_out"
                  ]
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "admin.invitation.sent",
                      "admin.invitation.revoked",
                      "admin.invitation.totp_issued",
                      "admin.invitation.accept_failed",
                      "admin.invitation.accepted",
                      "admin.totp.enabled",
                      "admin.sign_in.password_failed",
                      "admin.sign_in.password_passed",
                      "admin.sign_in.totp_failed",
                      "admin.sign_in.blocked",
                      "admin.sign_in.succeeded",
                      "admin.session.revoked",
                      "admin.sign_out"
                    ]
                  }
                }
              ]
            },
            "required": false,
            "name": "action",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "required": false,
            "name": "adminId",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "required": false,
            "name": "system",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "required": false,
            "name": "entityType",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "required": false,
            "name": "entityId",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "required": false,
            "name": "from",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "required": false,
            "name": "to",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 100
            },
            "required": false,
            "name": "q",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "One page of logs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AuditLog"
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "nextCursor"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_FAILED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED or ACCESS_TOKEN_EXPIRED: refresh, or sign in.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "ACCOUNT_NOT_ACTIVE",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
